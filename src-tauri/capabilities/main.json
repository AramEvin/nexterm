{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege capability for the main NexTerm window. Grant new commands explicitly.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-get-app-info",
    "allow-library-list",
    "allow-folder-create",
    "allow-folder-rename",
    "allow-folder-move",
    "allow-folder-delete",
    "allow-session-create",
    "allow-session-update",
    "allow-session-delete",
    "allow-session-duplicate",
    "allow-session-move",
    "allow-session-set-favorite",
    "allow-session-mark-connected",
    "allow-ssh-connect",
    "allow-ssh-write",
    "allow-ssh-resize",
    "allow-ssh-disconnect",
    "allow-ssh-reconnect",
    "allow-ssh-duplicate",
    "allow-ssh-forget"
  ]
}
