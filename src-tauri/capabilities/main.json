{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege capability for the main NexTerm window. Grant new commands explicitly.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-get-app-info",
    "allow-ssh-connect",
    "allow-ssh-write",
    "allow-ssh-resize",
    "allow-ssh-disconnect",
    "allow-ssh-reconnect",
    "allow-ssh-duplicate",
    "allow-ssh-forget"
  ]
}
