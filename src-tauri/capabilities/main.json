{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege capability for the main NexTerm window. Grant new commands explicitly.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-get-app-info",
    "allow-library-list",
    "allow-folder-create",
    "allow-folder-rename",
    "allow-folder-move",
    "allow-folder-delete",
    "allow-session-create",
    "allow-session-update",
    "allow-session-delete",
    "allow-session-duplicate",
    "allow-session-move",
    "allow-session-set-favorite",
    "allow-session-mark-connected",
    "allow-ssh-connect",
    "allow-ssh-write",
    "allow-ssh-resize",
    "allow-ssh-disconnect",
    "allow-ssh-reconnect",
    "allow-ssh-duplicate",
    "allow-ssh-forget",
    "allow-ssh-connect-saved",
    "allow-ssh-prompt-respond",
    "allow-vault-status",
    "allow-vault-setup",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-forget-device",
    "allow-vault-change-password",
    "allow-vault-set-auto-lock",
    "allow-vault-touch",
    "allow-credential-list",
    "allow-credential-create-password",
    "allow-credential-import-key",
    "allow-credential-update",
    "allow-credential-delete",
    "allow-folder-set-default-credential",
    "allow-known-hosts-list",
    "allow-known-hosts-remove",
    "allow-sftp-open-saved",
    "allow-sftp-open-connection",
    "allow-sftp-close",
    "allow-fs-home",
    "allow-fs-list",
    "allow-fs-mkdir",
    "allow-fs-rename",
    "allow-fs-delete",
    "allow-fs-chmod",
    "allow-transfer-start",
    "allow-transfer-cancel"
  ]
}
