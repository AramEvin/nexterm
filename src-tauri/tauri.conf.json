{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexTerm",
  "version": "0.5.0",
  "identifier": "com.nexterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NexTerm",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "NexTerm contributors",
    "copyright": "Copyright (c) 2026 NexTerm contributors",
    "category": "DeveloperTool",
    "shortDescription": "Open-source SSH/SFTP client",
    "longDescription": "NexTerm is a free, open-source, security-focused SSH and SFTP client.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
